footer {
    width: 100%;
    background: linear-gradient(to right, #f769a4, #c22e6c);
    color: white;
    text-align: center;
    padding: 10px 0;
    border-top: 12px solid;
    border-image: linear-gradient(to right, black, gray, black) 1;
    box-shadow: 0px 10px 30px rgba(0, 0, 0, 0.2);
    position: relative;
  }
  
  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 10px;
  }
  
  .footer-logo img {
    width: 150px;
    height: auto;
    margin-bottom: 10px;
  }
  
  .footer-info {
    font-size: 14px;
    padding-top: 10px;
    width: 100%;
    text-align: center;
  }
  
  .footer-info a {
    color: white;
    text-decoration: none;
  }
  
  .footer-info a:hover {
    text-decoration: underline;
  }
  
  .footer-gif {
    position: absolute;
    top: -250px;
    right: 10px;
  }
  
  .footer-gif img {
    width: 250px;
    height: auto;
  }
